{
  "name": "lingbloomtalk-api",
  "version": "1.0.0",
  "description": "LingBloomTalk REST API (Node 22, Express 5, TypeScript, MongoDB)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file-if-exists=.env src/db/seed/run.ts",
    "seed:dev-user": "tsx --env-file-if-exists=.env src/db/seed/devUser.ts",
    "migrate:up": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "openapi": "tsx src/openapi/write.ts",
    "prepare": "husky || true",
    "start:migrate": "node dist/src/db/migrate.js up",
    "start:seed": "node dist/src/db/seed/run.js",
    "openapi:check": "npm run openapi && git diff --exit-code openapi.json"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
