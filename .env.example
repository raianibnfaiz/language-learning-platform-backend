NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
# A replica set is required (transactions). directConnection=true lets the host talk to the
# single-node set started by docker-compose.
MONGODB_URI=mongodb://localhost:27017/lingbloomtalk?replicaSet=rs0&directConnection=true
# At least 32 bytes. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# Optional asymmetric signing instead of the shared secret (PEM, \n-escaped):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_ALGORITHM=RS256
JWT_ACCESS_TTL=15m
JWT_ISSUER=lingbloomtalk-api
JWT_AUDIENCE=lingbloomtalk-clients
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
# strict when web and API share a site, lax when the API lives on another site
COOKIE_SAMESITE=strict
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# links in emails
APP_WEB_URL=http://localhost:5173
# empty = log emails to the console
SMTP_URL=
EMAIL_FROM="LingBloomTalk <no-reply@example.com>"
MIN_APP_VERSION_IOS=1.0.0
MIN_APP_VERSION_ANDROID=1.0.0
MIN_APP_VERSION_WEB=0.0.0
MAX_DAILY_XP=2000
# none | deepl | google | llm  (phase 2)
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
TRANSLATION_DAILY_CHAR_LIMIT=20000
# off | intents | llm  (phase 2)
HELP_BOT_MODE=off
# mongo (shared across instances) | memory
RATE_LIMIT_STORE=mongo
RATE_LIMIT_ENABLED=true
JOBS_ENABLED=true
# defaults to true outside production
DOCS_ENABLED=
SOURCE_DATA_DIR=source-data
SEED_ASSERT_COUNTS=true
LOG_LEVEL=info
